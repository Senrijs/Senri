{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchFileNames": ["docs/website/**"],
      "groupName": "docs website",
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "semanticCommitType": "chore"
    },
    {
      "matchFileNames": ["bench/**"],
      "groupName": "bench",
      "semanticCommitType": "chore"
    },
    {
      "description": "senri-0.2.9 is an npm alias pinned to @senrijs/senri 0.2.9 to compare against the version before the Node shortcuts (#44, #46, #47). Never update it.",
      "matchFileNames": ["bench/package.json"],
      "matchDepNames": ["senri-0.2.9"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
