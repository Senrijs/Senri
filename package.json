{
  "name": "@senrijs/senri",
  "version": "0.2.0",
  "description": "Web 標準の Request / Response で書かれた、小さな Web フレームワーク。Bun・Deno・Node.js・Cloudflare Workers で動く",
  "license": "MIT",
  "author": "ibuki-hum4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senrijs/Senri.git"
  },
  "homepage": "https://github.com/Senrijs/Senri#readme",
  "bugs": {
    "url": "https://github.com/Senrijs/Senri/issues"
  },
  "keywords": [
    "web",
    "framework",
    "router",
    "http",
    "fetch",
    "bun",
    "deno",
    "node",
    "cloudflare-workers",
    "standard-schema"
  ],
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./dev": {
      "types": "./dist/src/dev/index.d.ts",
      "import": "./dist/src/dev/index.js"
    },
    "./cookie": {
      "types": "./dist/src/cookie.d.ts",
      "import": "./dist/src/cookie.js"
    },
    "./ip": {
      "types": "./dist/src/ip.d.ts",
      "import": "./dist/src/ip.js"
    },
    "./node": {
      "types": "./dist/adapters/node/index.d.ts",
      "import": "./dist/adapters/node/index.js"
    },
    "./serve": {
      "types": "./dist/adapters/serve/index.d.ts",
      "import": "./dist/adapters/serve/index.js"
    },
    "./static": {
      "types": "./dist/adapters/static/index.d.ts",
      "import": "./dist/adapters/static/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:pages": "vite build -c ui/vite.config.ts && node scripts/build-pages.ts",
    "typecheck": "bun run build && bun check && bun check -p test && bun check -p test/node && bun check -p adapters/node && bun check -p examples/bun && bun check -p examples/node && bun check -p scripts && deno check examples/deno/index.ts && bun check -p adapters/serve && bun check -p adapters/static && bun check -p ui",
    "dev": "bun --watch examples/bun/index.ts",
    "test": "bun test",
    "test:node": "bun run build && node --test --test-timeout=5000 \"test/node/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "arktype": "2.2.8",
    "playwright": "1.64.0",
    "typescript": "^7",
    "valibot": "1.5.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vue": "3.5.44",
    "workerd": "1.20261010.1",
    "wrangler": "4.149.0",
    "zod": "4.6.6"
  }
}
