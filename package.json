{
  "name": "senri",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/adapters/node/index.d.ts",
      "import": "./dist/adapters/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun run build && bun check && bun check -p test && bun check -p test/node && bun check -p adapters/node && bun check -p examples/bun && bun check -p examples/node && bun check -p scripts && deno check examples/deno/index.ts",
    "dev": "bun --watch examples/bun/index.ts",
    "test": "bun test",
    "test:node": "bun run build && node --test --test-timeout=5000 \"test/node/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^7"
  }
}
