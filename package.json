{
  "name": "@senrijs/senri",
  "version": "0.2.22",
  "description": "A small web framework built on Web standards. Runs on Bun, Deno, Node.js, Cloudflare Workers and browsers.",
  "license": "MIT",
  "author": "ibuki-hum4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senrijs/Senri.git"
  },
  "homepage": "https://github.com/Senrijs/Senri#readme",
  "bugs": {
    "url": "https://github.com/Senrijs/Senri/issues"
  },
  "keywords": [
    "web",
    "framework",
    "router",
    "http",
    "fetch",
    "bun",
    "deno",
    "node",
    "cloudflare-workers",
    "standard-schema"
  ],
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./dev": {
      "types": "./dist/src/dev/index.d.ts",
      "import": "./dist/src/dev/index.js"
    },
    "./cookie": {
      "types": "./dist/src/cookie.d.ts",
      "import": "./dist/src/cookie.js"
    },
    "./ip": {
      "types": "./dist/src/ip.d.ts",
      "import": "./dist/src/ip.js"
    },
    "./streaming": {
      "types": "./dist/src/streaming.d.ts",
      "import": "./dist/src/streaming.js"
    },
    "./multipart": {
      "types": "./dist/src/multipart.d.ts",
      "import": "./dist/src/multipart.js"
    },
    "./problem": {
      "types": "./dist/src/problem.d.ts",
      "import": "./dist/src/problem.js"
    },
    "./jwt": {
      "types": "./dist/src/jwt.d.ts",
      "import": "./dist/src/jwt.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    },
    "./websocket": {
      "types": "./dist/src/websocket.d.ts",
      "import": "./dist/src/websocket.js"
    },
    "./openapi": {
      "types": "./dist/src/openapi.d.ts",
      "import": "./dist/src/openapi.js"
    },
    "./otel": {
      "types": "./dist/src/otel.d.ts",
      "import": "./dist/src/otel.js"
    },
    "./metrics": {
      "types": "./dist/src/metrics.d.ts",
      "import": "./dist/src/metrics.js"
    },
    "./node": {
      "types": "./dist/adapters/node/index.d.ts",
      "import": "./dist/adapters/node/index.js"
    },
    "./serve": {
      "types": "./dist/adapters/serve/index.d.ts",
      "import": "./dist/adapters/serve/index.js"
    },
    "./static": {
      "types": "./dist/adapters/static/index.d.ts",
      "import": "./dist/adapters/static/index.js"
    },
    "./context-storage": {
      "types": "./dist/adapters/context-storage/index.d.ts",
      "import": "./dist/adapters/context-storage/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:pages": "vite build -c ui/vite.config.ts && node scripts/build-pages.ts",
    "typecheck": "bun run build && bun check && bun check -p test && bun check -p test/exact && bun check -p test/node && bun check -p adapters/node && bun check -p examples/bun && bun check -p examples/node && bun check -p scripts && deno check examples/deno/index.ts && bun check -p adapters/serve && bun check -p adapters/static && bun check -p adapters/context-storage && bun check -p ui && bun check -p packages/create-senri",
    "dev": "bun --watch examples/bun/index.ts",
    "test": "bun test",
    "test:node": "bun run build && node --test --test-timeout=5000 \"test/node/**/*.test.ts\"",
    "test:range": "node --test test/node/create-senri-range.ci.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:create": "node scripts/smoke-create.ts",
    "browser": "node scripts/browser.ts",
    "size": "bun scripts/size.ts"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.10",
    "arktype": "2.2.9",
    "playwright": "1.64.0",
    "typescript": "^7",
    "valibot": "1.5.0",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vue": "3.5.45",
    "workerd": "1.20261010.1",
    "wrangler": "4.149.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
